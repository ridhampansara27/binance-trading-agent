# Trading mode for src/trend_scalper app: backtest or testnet
TRADING_MODE=backtest

# Binance Futures Testnet (true/false)
BINANCE_TESTNET=true

# Live trading kill-switch (must remain false in this repository)
LIVE_TRADING=false

# Binance API credentials (leave empty for backtest)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Symbols to consider (comma-separated, USDT perps)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Timeframes for signal generation (comma-separated)
TIMEFRAMES=1m,5m

# Trend scanner window (minutes)
TREND_WINDOW_MINUTES=15

# Minimum 24h quote volume to consider a symbol (USD)
MIN_24H_VOLUME_USD=20000000

# Leverage (1 = no leverage)
LEVERAGE=1

# Risk per trade (fraction of equity)
RISK_PER_TRADE=0.0025

# Maximum daily loss (fraction of equity)
MAX_DAILY_LOSS=0.01

# Maximum open positions at once
MAX_OPEN_POSITIONS=2

# Fee and slippage assumptions
TAKER_FEE=0.0005
SLIPPAGE_BPS=2

# Stop-loss and take-profit (fraction of entry price)
STOP_LOSS_PCT=0.003
TAKE_PROFIT_PCT=0.006

# EMA periods
EMA_FAST=9
EMA_SLOW=21

# RSI settings
RSI_PERIOD=14
RSI_LOWER=40
RSI_UPPER=70

# Volume spike multiplier (vs rolling average)
VOLUME_SPIKE_MULT=1.5

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_agent.log
